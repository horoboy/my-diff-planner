Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Environment1
        - /FUEL Planning1
        - /Vehicle State1
      Splitter Ratio: 0.55
    Tree Height: 700
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 0.35
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 180; 180; 180
          Color Transformer: FlatColor
          Decay Time: 0.5
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Registered LiDAR Cloud
          Position Transformer: XYZ
          Queue Size: 2
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Topic: /laserMapping/cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 0.8
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 2
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 70; 190; 70
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Inflated Occupancy
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.1
          Style: Flat Squares
          Topic: /sdf_map/occupancy_inflate
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
      Enabled: true
      Name: Environment
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/frontier
          Name: Frontiers
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/trajectory
          Name: Planned Trajectory
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/travel_traj
          Name: Travel Trajectory
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /planning/position_cmd_vis
          Name: Position Command
          Namespaces:
            {}
          Queue Size: 100
          Value: false
      Enabled: true
      Name: FUEL Planning
    - Class: rviz/Group
      Displays:
        - Angle Tolerance: 0.1
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.3
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 200
          Name: EKF Odometry
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 0.35
            Axes Radius: 0.04
            Color: 255; 25; 0
            Head Length: 0.07
            Head Radius: 0.035
            Shaft Length: 0.2
            Shaft Radius: 0.02
            Value: Axes
          Topic: /ekf/ekf_odom
          Unreliable: false
          Value: true
        - Alpha: 1
          Axes Length: 0.25
          Axes Radius: 0.03
          Class: rviz/Pose
          Color: 0; 255; 0
          Enabled: false
          Head Length: 0.08
          Head Radius: 0.04
          Name: LiDAR Sensor Pose
          Shaft Length: 0.25
          Shaft Radius: 0.02
          Shape: Axes
          Topic: /fuel/sensor_pose
          Unreliable: false
          Value: false
      Enabled: true
      Name: Vehicle State
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Angle: -0.65
      Class: rviz/Orbit
      Distance: 12
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1440
  X: 80
  Y: 40
