<launch>
  <arg name="sitl_ns" default="/sitl" />
  <arg name="map_size_x" default="50.0" />
  <arg name="map_size_y" default="50.0" />
  <arg name="map_size_z" default="10.0" />
  <arg name="odom_topic" default="$(arg sitl_ns)/ground_truth/odom" />

  <node pkg="map_generator" name="map_pub" type="map_pub" output="screen"
        args="$(find map_generator)/resource/office.pcd" />

  <node pkg="local_sensing_node" type="pcl_render_node"
        name="pcl_render_node" output="screen">
    <rosparam command="load" file="$(find local_sensing_node)/params/camera.yaml" />
    <param name="sensing_horizon" value="5.0" />
    <param name="sensing_rate" value="15.0" />
    <param name="estimation_rate" value="15.0" />
    <param name="map/x_size" value="$(arg map_size_x)" />
    <param name="map/y_size" value="$(arg map_size_y)" />
    <param name="map/z_size" value="$(arg map_size_z)" />
    <remap from="~global_map" to="/map_generator/global_cloud" />
    <remap from="~odometry" to="$(arg odom_topic)" />
  </node>

  <include file="$(find exploration_manager)/launch/algorithm.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)" />
    <arg name="map_size_y_" value="$(arg map_size_y)" />
    <arg name="map_size_z_" value="$(arg map_size_z)" />
    <arg name="box_min_x" value="-9.0" />
    <arg name="box_min_y" value="-14.0" />
    <arg name="box_min_z" value="0.2" />
    <arg name="box_max_x" value="9.0" />
    <arg name="box_max_y" value="14.0" />
    <arg name="box_max_z" value="1.8" />
    <arg name="odometry_topic" value="$(arg odom_topic)" />
    <arg name="sensor_pose_topic" value="/pcl_render_node/sensor_pose" />
    <arg name="depth_topic" value="/pcl_render_node/depth" />
    <arg name="cloud_topic" value="/pcl_render_node/cloud" />
    <arg name="cx" value="321.04638671875" />
    <arg name="cy" value="243.44969177246094" />
    <arg name="fx" value="387.229248046875" />
    <arg name="fy" value="387.229248046875" />
    <arg name="max_vel" value="0.70" />
    <arg name="max_acc" value="1.00" />
    <arg name="max_jerk" value="2.00" />
    <arg name="ground_height" value="0.0" />
    <arg name="virtual_ceil_height" value="1.8" />
  </include>

  <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="/fuel/position_cmd_raw" />
    <remap from="/odom_world" to="$(arg odom_topic)" />
    <param name="traj_server/pub_traj_id" value="4" type="int" />
    <param name="traj_server/init_x" value="0.0" type="double" />
    <param name="traj_server/init_y" value="0.0" type="double" />
    <param name="traj_server/init_z" value="0.9" type="double" />
    <param name="traj_server/enable_init_motion" value="false" type="bool" />
    <param name="perception_utils/top_angle" value="0.56125" type="double" />
    <param name="perception_utils/left_angle" value="0.69222" type="double" />
    <param name="perception_utils/right_angle" value="0.68901" type="double" />
    <param name="perception_utils/max_dist" value="4.5" type="double" />
    <param name="perception_utils/vis_dist" value="1.0" type="double" />
  </node>

  <node pkg="waypoint_generator" name="waypoint_generator"
        type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)" />
    <remap from="~goal" to="/move_base_simple/goal" />
    <remap from="~traj_start_trigger" to="$(arg sitl_ns)/traj_start_trigger" />
    <param name="waypoint_type" value="point" />
  </node>
</launch>
